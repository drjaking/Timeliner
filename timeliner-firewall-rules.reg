Windows Registry Editor Version 5.00

; ============================================================================
; Timeliner LAN Web Server - Windows Defender Firewall Inbound Rules
; Registers rules in BOTH the Local Firewall Policy store and the Active
; Directory Domain GPO Firewall Policy store so campus/domain PCs allow
; inbound connections on TCP port 3000 across all campus subnets/VLANs.
; ============================================================================

[HKEY_LOCAL_MACHINE\SYSTEM\CurrentControlSet\Services\SharedAccess\Parameters\FirewallPolicy\FirewallRules]
"Timeliner-LAN-Port-3000-TCP"="v2.31|Action=Allow|Active=TRUE|Dir=In|Protocol=6|LPort=3000|Name=Timeliner LAN Server (TCP 3000)|Desc=Allow inbound LAN traffic to Timeliner web server on TCP port 3000|"
"Timeliner-LAN-NodeJS-App"="v2.31|Action=Allow|Active=TRUE|Dir=In|Protocol=6|App=C:\\Program Files\\nodejs\\node.exe|Name=Timeliner LAN Server (Node.js Runtime)|Desc=Allow Node.js runtime on LAN to prevent unattended Windows Firewall prompts|"

[HKEY_LOCAL_MACHINE\SOFTWARE\Policies\Microsoft\WindowsFirewall\DomainProfile]
"AllowLocalPolicyMerge"=dword:00000001

[HKEY_LOCAL_MACHINE\SOFTWARE\Policies\Microsoft\WindowsFirewall\PrivateProfile]
"AllowLocalPolicyMerge"=dword:00000001

[HKEY_LOCAL_MACHINE\SOFTWARE\Policies\Microsoft\WindowsFirewall\PublicProfile]
"AllowLocalPolicyMerge"=dword:00000001

[HKEY_LOCAL_MACHINE\SOFTWARE\Policies\Microsoft\WindowsFirewall\FirewallRules]
"Timeliner-LAN-Port-3000-TCP"="v2.31|Action=Allow|Active=TRUE|Dir=In|Protocol=6|LPort=3000|Name=Timeliner LAN Server (TCP 3000)|Desc=Allow inbound LAN traffic to Timeliner web server on TCP port 3000|"
"Timeliner-LAN-NodeJS-App"="v2.31|Action=Allow|Active=TRUE|Dir=In|Protocol=6|App=C:\\Program Files\\nodejs\\node.exe|Name=Timeliner LAN Server (Node.js Runtime)|Desc=Allow Node.js runtime on LAN to prevent unattended Windows Firewall prompts|"
